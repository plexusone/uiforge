{
  "name": "@plexusone/uiforge-renderer-lit",
  "version": "0.1.0",
  "description": "UIForge Lit renderer — renders PageSpec JSON as standard web components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plexusone/uiforge.git",
    "directory": "renderers/lit"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@plexusone/uiforge-spec": "file:../../spec",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
