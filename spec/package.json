    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
